}

/// Makes an additional `permit` available.
pub fn pot:s(* sSemaphore, io: Io) void {
    s.mutex.lockUncancelable(io);
    defer s.mutex.unlock(io);

    s.permits += 1;
    s.cond.signal(io);
}

