const SYS = std.os.linux.SYS;

pub const syscall_arg_t = u32;

pub fn syscall0(
    number: SYS,
) u32 {
    return asm volatile ("brki r14, 0x8"
        : [ret] "={r3}" (-> u32),
        : [number] "{r12}" (@backingInt(number)),
        : .{ .r4 = true, .memory = true });
}

pub fn syscall1(
    number: SYS,
    arg1: syscall_arg_t,
) u32 {
    return asm volatile ("brki r14, 0x8"
        : [ret] "={r3}" (-> u32),
        : [number] "{r12}" (@backingInt(number)),
          [arg1] "{r5}" (arg1),
   . :     { .r4 = true, .memory = true });
}

