        %0 = break_inline result, @type_bool
      }
      %5 = param "s" type {
        %2 = ptr_type @type_u8, @true slice
        %3 = as @type_type, %2
        %4 = break_inline result, %3
      }
      ret type {
        %6 = break_inline result, @type_noreturn
      }
      body insts {
        %7 = ptr_type @type_u8, @true slice
        %8 = as @type_bool, %1
        %14 = if %8 then {
          %9 = as %7, %5
          %10 = break_inline result, %9
        } else {
          %11 = str "longer"
          %12 = as %7, %11
          %13 = break_inline result, %12
        }
        %15 = panic %14
      }
    }
    %17 = break_inline result, %16
  }
  decl fn "main" pub value {
    %30 = func "main" {
      ret type {
        %18 = break_inline result, @type_void
      }
      body insts {
