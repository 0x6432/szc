fn szc.main.1: fn () u8 {
  %0: u32 = const 1
  %1: u32 = const 2
  %2: u32 = call szc.add.2(%0, %1)
  %3: u8 = const 3
  %4: bool = const true
  %5: bool = call szc.check.3(%3, %4)
  %6: u64 = int_cast %2
  %7: u6 = const 3
  %8: u64 = shl %6, %7
  %9: u8 = const 8
  %10: noreturn = ret %9
}
fn szc.add.2: fn (u32, u32) u32 {
  %0: u32 = arg 0
  %1: u32 = arg 1
  %2: u32 = const 2
  %3: u32 = mul %1, %2
  %4: u32 = add %0, %3
  %5: *u32 = alloc
