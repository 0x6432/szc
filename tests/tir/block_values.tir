  %13: noreturn = ret %6
}
fn szc.choose.2: fn (bool, u8, u16) u16 {
  %0: bool = arg 0
  %1: u8 = arg 1
  %2: u16 = arg 2
  %3: u16 = block {
    %4: void = block {
      %7: noreturn = condbr %0 then {
        %5: noreturn = block {
          %9: u16 = int_cast %1
          %10: noreturn = br %3, %9
        }
      } else {
        %6: noreturn = br %4
      }
    }
    %8: noreturn = block {
      %11: noreturn = br %3, %2
