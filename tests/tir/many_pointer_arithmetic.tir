fn szc.main.1: fn () u8 {
  %0: *[3]u16 = alloc
  %1: *const [3]u16 = const ref(object.1)
  %2: void = array_copy %0, %1
  %3: [*]u16 = ptr_cast %0
  %4: usize = const 2
  %5: [*]u16 = call szc.advance.3(%3, %4)
  %6: [*]const u16 = ptr_cast %5
  %7: [*]const u16 = ptr_cast %3
  %8: usize = call szc.delta.2(%6, %7)
  %9: u8 = int_cast %8
  %10: noreturn = ret %9
}
fn szc.delta.2: fn ([*]const u16, [*]const u16) usize {
  %0: [*]const u16 = arg 0
  %1: [*]const u16 = arg 1
  %2: usize = ptr_to_int %0
  %3: usize = ptr_to_int %1
  %4: usize = sub_wrap %2, %3
  %5: usize = const 2
  %6: usize = div_exact %4, %5
  %7: noreturn = ret %6
}
fn szc.advance.3: fn ([*]u16, usize) [*]u16 {
  %0: [*]u16 = arg 0
  %1: usize = arg 1
  %2: *[*]u16 = alloc
  %3: void = store %2, %0
