  %6: void = store %2, %5
  %7: [*]u16 = load %2
  %8: usize = const 1
  %9: [*]u16 = ptr_sub %7, %8
  %10: void = store %2, %9
  %11: [*]u16 = load %2
  %12: noreturn = ret %11
}
