function w $szc.main.1() {
@start
	%t1 =w call $szc.read.2(l $szc.const.1)
	%t3 =w cnew %t1, 42
	jnz %t3, @c9_then, @c9_else
@c9_then
	%t4 =w copy 1
	jmp @b4
@c9_else
	%t4 =w copy 0
	jmp @b4
@b4
	jnz %t4, @c19_then, @c19_else
@c19_then
	%t10 =w copy 1
	jmp @b10
@c19_else
	%t13 =w call $szc.runtime.3(w 7, w 0)
