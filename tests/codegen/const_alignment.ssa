	%t2 =l and %a2_round, -64
	storew %t0, %t2
	jnz %t1, @c7_then, @c7_else
@c7_then
	%t4 =l copy %t2
	jmp @b4
@c7_else
	%t4 =l copy %t2
	jmp @b4
@b4
