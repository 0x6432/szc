function w $szc.main.1() {
@start
	storeb 7, $szc.g.1
	%t3 =w call $szc.same.2()
	%t3 =w and %t3, 1
	%t4 =w xor %t3, 1
	%t4 =w and %t4, 1
	jnz %t4, @c9_then, @c9_else
@c9_then
	ret 1
@c9_else
	jmp @b5
@b5
	%t11 =w call $szc.add.3(w 2)
	%t11 =w and %t11, 255
	%t13 =w sub %t11, 9
	%t13 =w and %t13, 255
	%g13_overflow =w cultw %t11, 9
	jnz %g13_overflow, @g13_overflow_panic, @g13_overflow_ok
@g13_overflow_panic
	call $szc.panic.0()
	hlt
@g13_overflow_ok
	ret %t13
}

function w $szc.same.2() {
@start
	ret 1
}

function w $szc.add.3(w %t0) {
@start
	%t2 =w loadub $szc.g.1
	%t3 =w add %t2, %t0
	%t3 =w and %t3, 255
	%g3_overflow =w cultw %t3, %t2
	jnz %g3_overflow, @g3_overflow_panic, @g3_overflow_ok
@g3_overflow_panic
	call $szc.panic.0()
	hlt
@g3_overflow_ok
	storeb %t3, $szc.g.1
	%t7 =w loadub $szc.g.1
	ret %t7
}

data $szc.g.1 = align 1 { b 1 }
data $szc.panic.msg.0 = { b "integer overflow\n", b 0 }
function $szc.panic.0() {
@start
	call $write(w 2, l $szc.panic.msg.0, l 17)
	call $abort()
	hlt
}

export function w $main() {
@start
	%status =w call $szc.main.1()
	ret %status
}
