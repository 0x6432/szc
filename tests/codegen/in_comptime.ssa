function w $szc.main.1() {
@start
	%t1 =w call $szc.query.2(w 0)
	%t1 =w and %t1, 1
	jnz %t1, @c7_then, @c7_else
@c7_then
	%t2 =w copy 1
	jmp @b2
@c7_else
	%t2 =w copy 0
	jmp @b2
@b2
	jnz %t2, @c12_then, @c12_else
@c12_then
	ret 1
@c12_else
	jmp @b8
@b8
	ret 0
}

function w $szc.query.2(w %t0) {
@start
	jnz %t0, @c6_then, @c6_else
@c6_then
	%t1 =w copy 1
	jmp @b1
@c6_else
	%t1 =w copy 0
	jmp @b1
@b1
	ret %t1
}

export function w $main() {
@start
	%status =w call $szc.main.1()
	ret %status
}
