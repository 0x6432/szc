export function $abort_message(w %t0) {
@start
	call $szc.fail.3(w %t0)
	hlt
}

function w $szc.main.2() {
@start
	ret 0
}

function $szc.fail.3(w %t0) {
@start
	%t1 =l alloc8 8
	storel $szc.bytes.12, %t1
	jnz %t0, @c9_then, @c9_else
@c9_then
	%t4 =l copy $szc.bytes.13
	jmp @b4
@c9_else
	%t4 =l copy $szc.bytes.15
	jmp @b4
@b4
	storel %t4, %t1
	%t11 =l loadl %t1
	call $szc.panic.bytes(l %t11, l 4)
	hlt
}

section ".rodata"
data $szc.bytes.12 = { b 98, b 97, b 115, b 101, b 0 }
section ".rodata"
data $szc.bytes.13 = { b 108, b 101, b 102, b 116, b 0 }
section ".rodata"
data $szc.bytes.15 = { b 114, b 103, b 104, b 116, b 0 }
section ".rodata"
data $szc.panic.newline = { b 10 }
function $szc.panic.bytes(l %ptr, l %len) {
@start
	call $write(w 2, l %ptr, l %len)
	call $write(w 2, l $szc.panic.newline, l 1)
	call $abort()
	hlt
}

export function w $main() {
@start
	%status =w call $szc.main.2()
	ret %status
}
