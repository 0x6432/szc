function w $szc.main.1() {
@start
	%t0 =l alloc4 8
	call $memmove(l %t0, l $szc.g.1, l 8)
	%t3 =l call $szc.index.2()
	%g5_index =w cugel %t3, 2
	jnz %g5_index, @g5_index_panic, @g5_index_ok
@g5_index_panic
	call $szc.panic.7()
	hlt
@g5_index_ok
	%e5_offset =l mul %t3, 4
	%t5 =l add $szc.g.1, %e5_offset
	%e7_offset =l mul 0, 4
	%t7 =l add %t5, %e7_offset
	%t8 =l copy %t7
	storeh 7, %t8
	%e12_offset =l mul 1, 4
	%t12 =l add %t0, %e12_offset
	%e14_offset =l mul 0, 4
	%t14 =l add %t12, %e14_offset
	%t15 =l copy %t14
	%t16 =w loaduh %t15
	%t17 =l add $szc.g.1, 4
	%t18 =w loaduh %t17
	%t19 =w add %t16, %t18
	%t19 =w and %t19, 65535
	%g19_overflow =w cultw %t19, %t16
	jnz %g19_overflow, @g19_overflow_panic, @g19_overflow_ok
@g19_overflow_panic
	call $szc.panic.0()
	hlt
@g19_overflow_ok
	%t20 =l extuw %t19
	%t22 =l add %t20, 0
	%g22_overflow =w cultl %t22, %t20
	jnz %g22_overflow, @g22_overflow_panic, @g22_overflow_ok
@g22_overflow_panic
	call $szc.panic.0()
	hlt
@g22_overflow_ok
	%t23 =w copy %t22
	%t23 =w and %t23, 255
	ret %t23
}

function l $szc.index.2() {
@start
	ret 1
}

data $szc.g.1 = align 2 { h 1, b 2, b 9, h 3, b 4, b 9 }
data $szc.g.2 = align 2 { b 0 }
data $szc.panic.msg.0 = { b "integer overflow\n", b 0 }
function $szc.panic.0() {
@start
	call $write(w 2, l $szc.panic.msg.0, l 17)
	call $abort()
	hlt
}

data $szc.panic.msg.7 = { b "index out of bounds\n", b 0 }
function $szc.panic.7() {
@start
	call $write(w 2, l $szc.panic.msg.7, l 20)
	call $abort()
	hlt
}

export function w $main() {
@start
	%status =w call $szc.main.1()
	ret %status
}
