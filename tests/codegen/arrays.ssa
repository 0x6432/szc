function w $szc.main.1() {
@start
	%t2 =w call $szc.add.2(w 9, w 7)
	%t2 =w and %t2, 255
	%t4 =w cnew %t2, 16
	jnz %t4, @c9_then, @c9_else
@c9_then
	ret 1
@c9_else
	jmp @b5
@b5
	%t10 =w call $szc.other.4()
	%t10 =w and %t10, 255
	%t12 =w cnew %t10, 29
	jnz %t12, @c17_then, @c17_else
@c17_then
	ret 12
@c17_else
	jmp @b13
@b13
	ret 0
}

function w $szc.add.2(w %t0, w %t1) {
@start
	%t2 =w add %t0, %t1
	%t2 =w and %t2, 255
	%g2_overflow =w cultw %t2, %t0
	jnz %g2_overflow, @g2_overflow_panic, @g2_overflow_ok
@g2_overflow_panic
	call $szc.panic.0()
	hlt
@g2_overflow_ok
	ret %t2
}

function w $szc.other.4() {
@start
	ret 29
}

section ".data.rel.ro"
data $szc.g.1 = align 8 { z 8 }
section ".data.rel.ro"
data $szc.g.2 = align 8 { z 8 }
section ".data.rel.ro"
data $szc.g.3 = align 8 { z 8 }
data $szc.panic.msg.0 = { b "integer overflow\n", b 0 }
function $szc.panic.0() {
@start
	call $write(w 2, l $szc.panic.msg.0, l 17)
	call $abort()
	hlt
}

export function w $main() {
@start
	%status =w call $szc.main.1()
	ret %status
}
