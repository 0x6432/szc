section ".rodata"
data $szc.const.1 = align 1 { b 1, b 2 }
data $szc.panic.msg.0 = { b "integer overflow\n", b 0 }
function $szc.panic.0() {
@start
	call $write(w 2, l $szc.panic.msg.0, l 17)
	call $abort()
	hlt
}

data $szc.panic.msg.1 = { b "integer does not fit in destination type\n", b 0 }
function $szc.panic.1() {
@start
